<Project>

  <!--
    Copy this file to "secrets.props" (same folder) and put your Imgur Client-ID below.
    "secrets.props" is git-ignored, so it will NOT be committed to the public repository.

    Get a Client-ID at https://api.imgur.com/oauth2/addclient
      - Application name: CloudShot
      - Authorization type: "OAuth 2 authorization without a callback URL"
        (this is what enables anonymous uploads; only the Client-ID is needed, not the secret)

    Alternatively, you can skip this file and set the IMGUR_CLIENT_ID environment
    variable before building; it takes precedence over this file.
  -->

  <PropertyGroup>
    <ImgurClientId></ImgurClientId>
  </PropertyGroup>

</Project>
